{
  "$schema": "https://designtokens.org/schemas/2025.10/format.json",
  "$description": "Named OpenType weights so components never hardcode numbers.",
  "weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  }
}
