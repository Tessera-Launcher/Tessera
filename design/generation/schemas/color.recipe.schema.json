{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tessera.invalid/schemas/color-recipe.json",
  "title": "Color scale recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolution", "colors"],
  "properties": {
    "$schema": { "type": "string" },
    "resolution": { "type": "integer", "minimum": 1, "maximum": 50 },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "key", "saturation"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": ["colorSpace", "components"],
            "properties": {
              "colorSpace": { "enum": ["srgb", "oklch"] },
              "components": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          },
          "saturation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number", "minimum": 0, "maximum": 1 },
              "max": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
