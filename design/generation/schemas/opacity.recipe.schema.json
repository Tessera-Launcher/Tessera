{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opacity recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps","role"],
  "properties": {
  "$schema": {
    "type": "string"
  },
  "steps": {
    "type": "array",
    "items": {
      "type": "integer"
    },
    "minItems": 1
  },
  "role": {
    "type": "object",
    "required": [
      "name",
      "step"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "step": {
        "type": "integer"
      }
    }
  }
}
}
