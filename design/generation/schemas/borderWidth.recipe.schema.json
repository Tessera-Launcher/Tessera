{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Border width recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["basePx","steps","roles"],
  "properties": {
  "$schema": {
    "type": "string"
  },
  "basePx": {
    "type": "number",
    "exclusiveMinimum": 0
  },
  "steps": {
    "type": "array",
    "items": {
      "type": "integer"
    },
    "minItems": 1
  },
  "roles": {
    "type": "object",
    "additionalProperties": {
      "type": "integer"
    }
  }
}
}
