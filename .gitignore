/node_modules/
/target
# The vendored crates are independent workspaces with their own target dirs.
/vendor/*/target
# Generated by the vendored toolkit: a Forge/NeoForge installer writes its log
# into the process working directory, which is the repo root when a test runs it.
/installer.log
/log.txt

# The generated font assets are rebuilt by tools/fetch_pixel_font.py and
# tools/fetch_unifont.py.
/assets/fonts/*.otf
/assets/fonts/*.otf.gz
/assets/fonts/*.ttf
/assets/fonts/*.ttf.gz

# Python bytecode from local helper scripts.
__pycache__/
